# docker-compose uses ./server as its context, so ../.dockerignore does not apply.
# Keep Go sources, migrations and static/embed inputs; exclude host-only state.
.git
.github
node_modules
**/node_modules
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.exe
**/*.exe
*.test
*.out
mqvi
mqvi-server
*.db
*.db-wal
*.db-shm
**/*.db
**/*.db-wal
**/*.db-shm
*.sqlite
*.sqlite3
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite3-wal
**/*.sqlite3-shm
*.log
**/*.log
uploads
data
implementation
coverage
