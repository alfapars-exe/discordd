# ========================
# HiChat! Server Configuration
# ========================
# Copy this file as .env for local development:
#   cp .env.example .env
#
# In Hugging Face Space, do NOT use a .env file — set every value as a Space
# Secret/Variable instead (Settings → Variables and secrets).

# ─── Server ───
SERVER_HOST=0.0.0.0
# Port 7860 is the Hugging Face Space default. Override to 9090 for local dev.
SERVER_PORT=7860

# ─── Database ───
# Two options:
#   A) Local SQLite file (development):
#        DATABASE_PATH=./data/hichat.db
#   B) Turso / libSQL remote (production on HF Space):
#        DATABASE_URL=libsql://<your-db>-<org>.turso.io?authToken=<token>
# DATABASE_URL takes precedence when both are set.
DATABASE_PATH=./data/hichat.db
# DATABASE_URL=libsql://hichat-argeinfina.turso.io?authToken=your-token-here

# ─── JWT ───
# IMPORTANT: Use a strong random secret in production!
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Encryption ───
# AES-256 key for encrypting LiveKit credentials in DB (64 hex chars = 32 bytes)
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32

# ─── File Upload ───
# In HF Space this should match the bucket mount path (typically /data/uploads).
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_SIZE=26214400

# ─── CORS ───
# Comma-separated list. For HF Space deployment, add your Space URL:
#   CORS_ORIGINS=https://argeinfina-discord.hf.space
# CORS_ORIGINS=

# ─── LiveKit Cloud (recommended for HF Space) ───
# Sign up at https://cloud.livekit.io, create a project, then paste the WSS URL
# and API credentials here. These are seeded into the platform's LiveKit instance
# on first boot (subsequent management is via the in-app admin panel).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Email (optional — Resend API for password reset) ───
# Leave empty to disable forgot-password / email verification flows.
# RESEND_API_KEY=
# RESEND_FROM=noreply@example.com
# APP_URL=https://argeinfina-discord.hf.space

# ─── GIF search (optional — Klipy proxy) ───
# KLIPY_API_KEY=

# ─── Hetzner integration (optional — for self-hosted LiveKit instance tracking) ───
# HETZNER_API_TOKEN=
