{
  "private": true,
  "name": "hichat-desktop",
  "version": "2.11.113",
  "description": "HiChat! desktop application",
  "author": "akinalpfdn",
  "main": "dist-electron/main.js",
  "scripts": {
    "check:coverage": "node scripts/check-implementation-coverage.mjs",
    "check:acceptance": "node scripts/check-implementation-coverage.mjs --strict",
    "test:coverage": "node --test scripts/check-implementation-coverage.test.mjs",
    "electron:dev": "concurrently \"npm run dev --prefix client\" \"npx tsc -p electron/tsconfig.json && electron .\"",
    "clean:release": "node -e \"require('fs').rmSync('release',{recursive:true,force:true})\"",
    "electron:build": "npm run clean:release && npm run build --prefix client && npx tsc -p electron/tsconfig.json && electron-builder",
    "electron:dist": "npm run electron:build",
    "electron:test": "npx tsc -p electron/tsconfig.json && node --test dist-electron/*.test.js"
  },
  "dependencies": {
    "electron-updater": "^6",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "concurrently": "^10",
    "electron": "^45",
    "electron-builder": "26.18.0",
    "rcedit": "^5.0.2",
    "typescript": "~7.0.2"
  },
  "build": {
    "appId": "net.hichat.app",
    "productName": "HiChat!",
    "afterPack": "./build/after-pack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron",
      "client/dist",
      "icons"
    ],
    "artifactName": "hichat-setup.${ext}",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "publish": {
      "provider": "generic",
      "url": "https://huggingface.co/datasets/infinayazilim/hichat-releases/resolve/main/"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/hlogo.ico",
      "signAndEditExecutable": false,
      "executableName": "HiChat",
      "legalTrademarks": "HiChat!",
      "extraResources": [
        {
          "from": "native/audio-capture.exe",
          "to": "native/audio-capture.exe"
        },
        {
          "from": "native/game-window.exe",
          "to": "native/game-window.exe"
        }
      ]
    },
    "copyright": "© 2026 HiChat!",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "installerIcon": "icons/hlogo.ico",
      "uninstallerIcon": "icons/hlogo.ico",
      "installerHeaderIcon": "icons/hlogo.ico",
      "include": "build/installer.nsh"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icons/hlogo.png",
      "category": "Network;Chat",
      "executableName": "hichat"
    },
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.social-networking"
    }
  }
}
