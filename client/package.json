{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:audio": "vitest run src/audio src/hooks/useMicTest.test.tsx src/hooks/useInitialRoomSync.test.ts src/stores/p2pCallStore.audio.test.ts src/stores/p2pCallStore.camera.test.ts src/components/settings/VoiceSettings.audio.test.tsx src/stores/preferencesStore.test.ts",
    "test:audio:gate": "node --test scripts/audio-gate.test.mjs",
    "test:audio:wasm": "node --experimental-vm-modules --test scripts/audio-engines.verify.mjs",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:build": "tsc -b && vite build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@livekit/components-react": "^2.9.24",
    "@livekit/krisp-noise-filter": "^0.4.5",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.0.1",
    "@sapphi-red/dtln-web": "^0.1.4",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "@sentry/react": "^11.9.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-tflite": "^0.0.1-alpha.10",
    "deepfilternet3-noise-filter": "^1.3.0",
    "emoji-mart": "^5.6.0",
    "i18next": "^26.5.11",
    "i18next-browser-languagedetector": "^8.2.3",
    "idb": "^8.0.4",
    "livekit-client": "^2.23.0",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-i18next": "^17.1.9",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "@emoji-mart/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
