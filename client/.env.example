# Sentry error + performance monitoring — DSN-gated (initSentry() is a
# no-op when VITE_SENTRY_DSN is unset, see src/monitoring/sentry.ts).
# Do NOT put a real DSN value in this file — this file is checked in.
VITE_SENTRY_DSN=
# Optional — defaults to Vite's MODE (e.g. "production") when unset.
VITE_SENTRY_ENVIRONMENT=

# The single-destination UI is the default; set false only to roll back to classic.
# Build-time only: rebuild frontend (and deployment artifact) after changing.
VITE_UI_SHELL_V2=true

# Optional isolated development API target (PowerShell before npm run dev):
# $env:HICHAT_DEV_API_TARGET = 'http://127.0.0.1:9191'
# Dev proxy only; not injected into the built frontend.
